{
  "properties": {
    "assignees": {
      "description": "List of assigned members",
      "items": {
        "properties": {
          "member_email": {
            "type": "string"
          },
          "member_name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "assignee_emails": {
      "type": "array",
      "description": "Flat list of assignee emails for self-access RLS",
      "items": {
        "type": "string"
      }
    },
    "church_id": {
      "type": "string"
    },
    "date": {
      "format": "date",
      "type": "string"
    },
    "end_time": {
      "type": "string"
    },
    "group_id": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "reminder_3day_sent": {
      "default": false,
      "description": "Whether the 3-day advance reminder has been sent",
      "type": "boolean"
    },
    "reminder_sent": {
      "default": false,
      "description": "Whether the 24-hour advance reminder has been sent",
      "type": "boolean"
    },
    "send_reminder": {
      "default": false,
      "type": "boolean"
    },
    "time": {
      "description": "e.g. 9:00 AM",
      "type": "string"
    },
    "title": {
      "description": "e.g. Sunday Morning Service",
      "type": "string"
    }
  },
  "required": [
    "group_id",
    "church_id",
    "title",
    "date"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "global_admin"
          }
        },
        {
          "user_condition": {
            "role": "church_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.church_id": "{{user.data.church_id}}"
        },
        {
          "data.assignee_emails": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "global_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "global_admin"
          }
        },
        {
          "user_condition": {
            "role": "church_admin"
          }
        }
      ]
    }
  },
  "type": "object",
  "name": "MinistrySchedule"
}