{
  "name": "ChurchEvent",
  "type": "object",
  "properties": {
    "church_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "time": {
      "type": "string",
      "description": "e.g. 10:00 AM"
    },
    "end_time": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "service",
        "bible_study",
        "youth",
        "outreach",
        "fellowship",
        "conference",
        "other"
      ],
      "default": "service"
    },
    "image_url": {
      "type": "string"
    },
    "capacity": {
      "type": "number",
      "description": "Max attendees (0 = unlimited)"
    },
    "rsvp_count": {
      "type": "number",
      "default": 0
    },
    "is_published": {
      "type": "boolean",
      "default": true
    },
    "created_by": {
      "type": "string"
    },
    "enable_signup_form": {
      "type": "boolean",
      "default": false,
      "description": "Whether a public signup form is enabled for this event"
    },
    "signup_form_note": {
      "type": "string",
      "description": "Optional note shown on the signup form"
    },
    "notify_email": {
      "type": "string",
      "description": "Email to notify daily with signup counts (defaults to creator)"
    }
  },
  "required": [
    "church_id",
    "title",
    "date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.created_by": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "data.created_by": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.created_by": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}