{
  "name": "ChurchInvitation",
  "type": "object",
  "properties": {
    "church_id": {
      "type": "string",
      "description": "ID of the church"
    },
    "code": {
      "type": "string",
      "description": "Unique invitation code"
    },
    "user_email": {
      "type": "string",
      "description": "Email of user who signed up with this code"
    },
    "user_name": {
      "type": "string",
      "description": "Name of user who signed up"
    },
    "user_id": {
      "type": "string",
      "description": "Base44 user ID"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "verified",
        "rejected"
      ],
      "default": "pending",
      "description": "Admin verification status"
    },
    "verified_by": {
      "type": "string",
      "description": "Email of admin who verified"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "assigned_groups": {
      "type": "array",
      "description": "Ministry groups assigned to this user",
      "items": {
        "type": "object",
        "properties": {
          "group_id": {
            "type": "string"
          },
          "group_name": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "type": "string",
      "description": "Admin notes about the user"
    }
  },
  "required": [
    "church_id",
    "code",
    "user_email"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}