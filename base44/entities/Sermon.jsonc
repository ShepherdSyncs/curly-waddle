{
  "name": "Sermon",
  "type": "object",
  "properties": {
    "church_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "speaker": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "series": {
      "type": "string",
      "description": "Sermon series name"
    },
    "description": {
      "type": "string"
    },
    "scripture_reference": {
      "type": "string"
    },
    "video_url": {
      "type": "string",
      "description": "YouTube, Vimeo, or direct video link"
    },
    "audio_url": {
      "type": "string",
      "description": "Direct audio file URL"
    },
    "thumbnail_url": {
      "type": "string"
    },
    "duration_minutes": {
      "type": "number"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "is_published": {
      "type": "boolean",
      "default": true
    },
    "view_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "church_id",
    "title",
    "date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}