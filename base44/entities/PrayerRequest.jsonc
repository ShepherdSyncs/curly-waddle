{
  "name": "PrayerRequest",
  "type": "object",
  "properties": {
    "church_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "request": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "healing",
        "family",
        "finances",
        "relationships",
        "salvation",
        "guidance",
        "grief",
        "thanksgiving",
        "other"
      ],
      "default": "other"
    },
    "is_anonymous": {
      "type": "boolean",
      "default": false
    },
    "is_private": {
      "type": "boolean",
      "default": false,
      "description": "Visible only to the poster and church admins"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "answered",
        "closed"
      ],
      "default": "active"
    },
    "answered_at": {
      "type": "string",
      "format": "date-time",
      "description": "When it was marked answered"
    },
    "answered_by": {
      "type": "string",
      "description": "Name of who marked it answered"
    },
    "staff_notes": {
      "type": "string",
      "description": "Private notes for staff only"
    }
  },
  "required": [
    "church_id",
    "request"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}