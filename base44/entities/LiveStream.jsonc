{
  "name": "LiveStream",
  "type": "object",
  "properties": {
    "church_id": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "description": "Title of the service/stream"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "idle",
        "live",
        "ended"
      ],
      "default": "idle"
    },
    "stream_key": {
      "type": "string",
      "description": "Mux stream key for OBS"
    },
    "mux_live_stream_id": {
      "type": "string",
      "description": "Mux live stream ID"
    },
    "mux_playback_id": {
      "type": "string",
      "description": "Mux playback ID for HLS URL"
    },
    "thumbnail_url": {
      "type": "string"
    },
    "playback_url": {
      "type": "string",
      "description": "HLS playback URL (auto-set from Mux)"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "scheduled_for": {
      "type": "string",
      "format": "date-time",
      "description": "When this service is scheduled to go live (for advance scheduling)"
    },
    "source_stream_id": {
      "type": "string",
      "description": "ID of the master stream whose Mux credentials (stream key, RTMP, playback) this scheduled service reuses"
    },
    "viewer_count": {
      "type": "number",
      "default": 0
    },
    "destinations": {
      "type": "array",
      "description": "Simulcast destinations (YouTube, Facebook, etc.)",
      "items": {
        "type": "object",
        "properties": {
          "platform": {
            "type": "string"
          },
          "rtmp_url": {
            "type": "string"
          },
          "stream_key": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "mux_simulcast_id": {
            "type": "string"
          }
        }
      }
    },
    "chat_enabled": {
      "type": "boolean",
      "default": true
    },
    "is_archived": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "church_id",
    "title"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}