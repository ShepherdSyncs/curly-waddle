{
  "name": "FormIntegration",
  "type": "object",
  "properties": {
    "church_id": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "description": "Friendly label e.g. 'Sunday Visitor Form'"
    },
    "source": {
      "type": "string",
      "enum": [
        "google_forms",
        "typeform",
        "jotform",
        "other"
      ],
      "default": "other",
      "description": "Which form tool sends the webhook"
    },
    "webhook_token": {
      "type": "string",
      "description": "Secret token appended to the webhook URL for validation"
    },
    "field_map": {
      "type": "object",
      "description": "Maps form field names to ChurchMember fields (first_name, last_name, email, phone, address)",
      "properties": {
        "first_name": {
          "type": "string"
        },
        "last_name": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "address": {
          "type": "string"
        }
      }
    },
    "create_follow_up": {
      "type": "boolean",
      "default": true
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "last_received_at": {
      "type": "string",
      "format": "date-time"
    },
    "total_submissions": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "church_id",
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}