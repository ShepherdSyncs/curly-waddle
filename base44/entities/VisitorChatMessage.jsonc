{
  "name": "VisitorChatMessage",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "description": "VisitorChatSession id"
    },
    "church_id": {
      "type": "string"
    },
    "sender_type": {
      "type": "string",
      "enum": [
        "visitor",
        "ai",
        "pastoral",
        "system"
      ],
      "description": "Who sent the message"
    },
    "sender_name": {
      "type": "string"
    },
    "sender_email": {
      "type": "string"
    },
    "body": {
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "church_id",
    "sender_type",
    "body"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "data.church_id": "{{user.data.church_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "global_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.church_id": "{{user.data.church_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "global_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.church_id": "{{user.data.church_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "global_admin"
          }
        }
      ]
    }
  }
}