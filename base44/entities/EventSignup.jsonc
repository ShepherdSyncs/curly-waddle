{
  "name": "EventSignup",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "church_id": {
      "type": "string"
    },
    "event_title": {
      "type": "string"
    },
    "event_date": {
      "type": "string",
      "format": "date"
    },
    "name": {
      "type": "string",
      "description": "Name of the person signing up"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "guest_count": {
      "type": "number",
      "default": 0,
      "description": "Number of additional guests (not including themselves)"
    },
    "guest_names": {
      "type": "string",
      "description": "Names of guests they are bringing"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "church_id",
    "name"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}