{
  "description": "Twilio credentials for a church's mass-texting platform. Kept separate from the (publicly readable) Church record so credentials are never exposed cross-tenant.",
  "properties": {
    "admin_emails": {
      "description": "Denormalized snapshot of the church's admin emails, used for RLS",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "church_id": {
      "description": "ID of the church these credentials belong to",
      "type": "string"
    },
    "sms_enabled": {
      "default": false,
      "type": "boolean"
    },
    "sms_provider": {
      "default": "twilio",
      "enum": [
        "twilio"
      ],
      "type": "string"
    },
    "twilio_account_sid": {
      "type": "string"
    },
    "twilio_auth_token": {
      "type": "string"
    },
    "twilio_from_number": {
      "type": "string"
    }
  },
  "required": [
    "church_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.admin_emails": {
            "$in": [
              "{{user.email}}"
            ]
          }
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "global_admin"
          }
        },
        {
          "user_condition": {
            "role": "church_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.admin_emails": {
            "$in": [
              "{{user.email}}"
            ]
          }
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "global_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.admin_emails": {
            "$in": [
              "{{user.email}}"
            ]
          }
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "global_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.admin_emails": {
            "$in": [
              "{{user.email}}"
            ]
          }
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "global_admin"
          }
        }
      ]
    }
  },
  "type": "object",
  "name": "ChurchSmsCredentials"
}